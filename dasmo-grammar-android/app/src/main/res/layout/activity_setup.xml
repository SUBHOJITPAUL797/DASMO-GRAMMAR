<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#11111B"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Up Dasmo Keyboard"
        android:textColor="#CDD6F4"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Enjoy Grammarly-level instant corrections right inside any Android app."
        android:textColor="#A6ADC8"
        android:textSize="14sp" />

    <!-- Step 1 Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#181825"
        app:strokeColor="#313244"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1: Enable Keyboard"
                android:textColor="#CDD6F4"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pending activation"
                android:textColor="#F9E2AF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Open Keyboard Settings"
                android:backgroundTint="#313244"
                android:textColor="#CDD6F4" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Step 2 Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#181825"
        app:strokeColor="#313244"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2: Switch Default Keyboard"
                android:textColor="#CDD6F4"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Not selected as default"
                android:textColor="#F9E2AF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Switch Input Method"
                android:backgroundTint="#313244"
                android:textColor="#CDD6F4" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Step 3 Sandbox Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#181825"
        app:strokeColor="#313244"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 3: Try Typing in Sandbox"
                android:textColor="#CDD6F4"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSandbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#1E1E2E"
                android:padding="12dp"
                android:hint="Type here: 'She do not like it'"
                android:textColor="#CDD6F4"
                android:textColorHint="#585B70"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Finish Setup"
        android:textSize="15sp"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF" />

</LinearLayout>
