<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0F17">

    <!-- Premium App Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#111827"
        android:elevation="4dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_dasmo_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DASMO"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:letterSpacing="0.04"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="GRAMMAR"
                    android:textColor="#F9FAFB"
                    android:textSize="18sp"
                    android:letterSpacing="0.04"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100% On-Device AI • Zero Cloud Latency"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#064E3B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="10dp" />

        <ImageView
            android:id="@+id/btnCheckUpdate"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/stat_sys_download_done"
            android:contentDescription="Check for Updates"
            app:tint="#38BDF8"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#D1D5DB" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Keep Samsung Keyboard / Floating Assistant Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1F2937"
                app:strokeColor="#10B981"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="✨"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:background="#111827" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keep Samsung Keyboard"
                            android:textColor="#F9FAFB"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Floating Grammarly-style widget over Samsung Keyboard or Gboard."
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnEnableFloatingAssistant"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Enable"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="#10B981"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Switch to Dasmo Keyboard Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#111827"
                app:strokeColor="#374151"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_keyboard"
                        android:background="#1F2937"
                        android:padding="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Or Switch to Dasmo Keyboard"
                            android:textColor="#F9FAFB"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Full replacement keyboard with inline suggestion ribbon."
                            android:textColor="#9CA3AF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnEnableKeyboard"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Set Up"
                        android:textSize="13sp"
                        android:backgroundTint="#334155"
                        android:textColor="#F9FAFB" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Document Intelligence & Readability Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvStatsInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 words • 0 chars • 0 min read"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReadabilityGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score: 100 (Easy)"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Document Writing Pad Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#111827"
                app:strokeColor="#374151"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etEditor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="7"
                        android:gravity="top|start"
                        android:background="@null"
                        android:padding="18dp"
                        android:hint="Type or paste your text to check grammar and clarity..."
                        android:textColor="#F9FAFB"
                        android:textColorHint="#4B5563"
                        android:textSize="16sp"
                        android:lineSpacingMultiplier="1.3" />

                    <!-- Quick Action Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:background="#1F2937">

                        <TextView
                            android:id="@+id/btnPaste"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋 Paste"
                            android:textColor="#38BDF8"
                            android:textSize="13sp"
                            android:padding="6dp" />

                        <TextView
                            android:id="@+id/btnCopy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="📄 Copy"
                            android:textColor="#F9FAFB"
                            android:textSize="13sp"
                            android:padding="6dp" />

                        <TextView
                            android:id="@+id/btnShare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="📤 Share"
                            android:textColor="#F9FAFB"
                            android:textSize="13sp"
                            android:padding="6dp" />

                        <TextView
                            android:id="@+id/btnClear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Clear"
                            android:textColor="#F43F5E"
                            android:textSize="13sp"
                            android:padding="6dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Ready"
                            android:textColor="#10B981"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lints Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Writing Improvements"
                    android:textColor="#F9FAFB"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFixAll"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Fix All"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:checked="true"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCorrectness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correctness"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipClarity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clarity"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEngagement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Engagement"
                        style="@style/Widget.Material3.Chip.Filter" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Empty / Celebration State View -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCelebration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="#064E3B"
                app:strokeColor="#10B981"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_check_circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spotless Writing!"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Zero grammar, spelling, or clarity errors found."
                            android:textColor="#A7F3D0"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lints List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
