<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions for Keyboard Haptics & System Reliability -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Permission to display Grammarly-style floating widget over Samsung Keyboard -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Permissions for In-App Updates via GitHub Releases -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".DasmoApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_dasmo_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_dasmo_logo"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.DasmoGrammar">

        <!-- Main Document Editor & Hub Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keyboard Onboarding & Activation Wizard -->
        <activity
            android:name=".ui.KeyboardSetupActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="Set Up Keyboard" />

        <!-- Floating Assistant (Samsung Keyboard) Setup Wizard -->
        <activity
            android:name=".ui.FloatingAssistantSetupActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="Set Up Samsung Keyboard Assistant" />

        <!-- Settings & Dialect Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="Settings" />

        <!-- Diagnostics & Live Error Logs Activity -->
        <activity
            android:name=".ui.DebugLogActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="System Diagnostics &amp; Logs" />

        <!-- Floating Text Check (Android Process Text in any app) -->
        <activity
            android:name=".ui.ProcessTextActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:label="@string/check_with_dasmo"
            android:theme="@style/Theme.DasmoGrammar.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Dasmo Grammar Keyboard Input Method Service -->
        <service
            android:name=".keyboard.DasmoKeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Dasmo Floating Assistant Accessibility Service (Works over Samsung Keyboard & Gboard) -->
        <service
            android:name=".accessibility.DasmoFloatingAssistantService"
            android:exported="true"
            android:label="@string/floating_assistant_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- FileProvider for installing downloaded APK updates -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
